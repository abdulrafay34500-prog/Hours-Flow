<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/header.css">
         <link rel="stylesheet" href="/general.css">
         <link rel="stylesheet" href="/sidebar.css">
         <link rel="stylesheet" href="/weekley-overview.css">
         <link rel="stylesheet" href="/employes.css">
         <link rel="stylesheet" href="/addingemploypage.css">
         <link rel="stylesheet" href="/singleEmployDetail.css">
         <link rel="stylesheet" href="/historyPage.css">
         <link rel="stylesheet" href="/blurr.css">
        <title>Employes Details</title>
    </head>
    <body>
        <%- include('header.ejs')%>
        <%- include('sidebar.ejs')%>
        <main class="main-addingEmploy-page">

            <div class="combining-AddingAndSingle-Employ-div  js-combining-AddingAndSingle-Employ-div">
                <div class="Adding-Employe-main-div">
                    <div class="Employe-main-header">
                        <div class="header-text-div">
                            <p class="employes-text">Employees</p>
                            <p class="manage-team-text">Manage your team members and their details</p>

                        </div>
                        <button class="add-button js-add-employ-button">
                            + Add Employe 
                        </button>
                    </div>
                    <div class="employ-hours-payroll-div">
                        <div class="Total-employ-div">
                            <img class="employ-icon" src="icons/employ.png">
                            <p class="total-employ-text">Total Employes</p>
                            <p class="Employe-numbers js-Employe-numbers">0</p>
                        </div>
                        <div class="Total-Hours-div">
                            <img class="clock-icon" src="icons/clock.png">
                            <p class="total-Hours-text">Total Hours (This Month)</p>
                            <p class="Total-hours-numbers">0</p>
                        </div>
                        <div class="Total-Payroll-div">
                            <img class="currency-icon" src="icons/rupee.png">
                            <p class="total-Payroll-text">Total Payroll (This Month)</p>
                            <p class="monthly-Payroll-Amount">0</p>
                        </div>
                    </div>
                    <div class="Employe-Details-main-div">
                        <div class="Employer-Details-mainHeader">
                            <p class="Employ-id">ID</p>
                            <P class="Employ-namee">Employ Name</P>
                            <p class="Employ-ShiftTypee">Shift Type</p>
                        </div>
                        <div class="added-Employes-details js-added-Employes-details">
                        
                            
                        </div>

                    </div>
                </div>
               
                <div class="Single-employ-detail js-Single-employ-detail">



                </div>

            </div>

            <div class="AddingEmploye-main-page js-AddingEmploye-main-page">
                    
            </div>
           
            <div class="delete-popup js-delete-popup">

            </div>
           
            <div  class="js-history-page-popup">
                
            </div>

          

        </main>
          <form method="post" action="/addemployPage" >
                 <div class="adding-employ-div">
                    <h1>Add Employ</h1>
                    <div class="input-id-div">
                        <h3>Enter Id :</h3>
                        <input class="id-input js-id-input" type="number" name="id" >
                    </div>
                    <div class="input-name-div">
                        <h3>Enter Name :</h3>
                        <input class="name-input js-name-input" type="text" name="name">
                    </div>
                    <div class="input-hourleyInput-div">
                        <h3>Enter Hourley wage</h3>
                        <input class="hourleyInput-input js-hourleyInput-input" type="number" name="hourleyWage" >
                    </div>
                    <div class="input-position-div">
                        <h3>Enter Job Role</h3>
                        <input class="jobRole-input js-jobRole-input" value=Customer-Support-Representative name="jobRole">
                    </div>
                    <div class="input-Email-div">
                        <h3>Enter Email</h3>
                        <input class="Email-input js-Email-input" value=N/A name="email">
                    </div>
                        <div class="input-Phonenumber-div">
                        <h3>Enter Phone number</h3>
                        <input class="Phonenumber-input js-Phonenumber-input"  value=N/A name="PhoneNo">
                    </div>
                    <div class="input-JoiningDate-div">
                        <h3>Enter Joining Date</h3>
                        <input class="JoiningDate-input js-JoiningDate-input" value=N/A name="joiningDate">
                    </div>
                    <div class="input-shift-div">
                        <h3>Select Shift Type :</h3>
                        <select class="Select-shift js-Select-shift" name="shiftType">
                            <option selected>Morning</option>
                            <option >Evening</option>
                        </select>
                    </div>
                    <button class="Save-button js-save-update-button">
                        Save
                    </button>
                    <a href="/" class="Cross-sign js-Cross-sign">
                    ✖ 
                    </a>                  
                </div>
                <div class="Error-notification">
                    <p class="Error-Text">Error</p>
                    <p class="Error-reason js-Error-reason"></p>
                </div>
          </form>


    </body>
    <script src="script/addingEmploy.js" type="module"></script>
</html>