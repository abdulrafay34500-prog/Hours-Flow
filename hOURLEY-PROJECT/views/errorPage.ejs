
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


    <title>404 - Page Not Found | HourFlow</title>

    <link rel="stylesheet" href="/errorPage.css">
</head>
<body>

    <header class="navbar">
        <a href="/" class="logo">
            <span class="logo-icon">H</span>
            <span>HourFlow</span>
        </a>

        <span class="help-text">Need help?</span>
    </header>

    <main class="error-container">

        <div class="error-illustration">
            <div class="illustration-circle">
                <svg
                    width="76"
                    height="76"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <path d="M14 2v6h6"/>
                    <path d="m9 13 6 6"/>
                    <path d="m15 13-6 6"/>
                </svg>
            </div>
            <span class="floating-dot dot-one"></span>
            <span class="floating-dot dot-two"></span>
            <span class="floating-dot dot-three"></span>
        </div>

        <p class="error-code"><%=reason%></p>

        <h1>Page not found</h1>

        <p class="error-description">
            Oops! The page you're looking for doesn't exist,
            may have been moved, or the link might be incorrect.
        </p>

        <div class="error-actions">
            <a href="/" class="primary-button">
                <span>←</span>
                Back to dashboard
            </a>

            <button
                type="button"
                class="secondary-button"
                onclick="history.back()"
            >
                Go back
            </button>
        </div>

        <div class="error-footer">
            <span class="status-dot"></span>
            <span>Don't worry, your employee data is safe.</span>
        </div>

    </main>

    <footer class="page-footer">
        <p>© 2026 HourFlow. All rights reserved.</p>
    </footer>

</body>
</html>
