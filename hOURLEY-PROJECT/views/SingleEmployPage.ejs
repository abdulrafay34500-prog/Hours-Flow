
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Employee Details | HourFlow</title>

    <link rel="stylesheet" href="/general.css">
    <link rel="stylesheet" href="/header.css">
    <link rel="stylesheet" href="/sidebar.css">
    <link rel="stylesheet" href="/singleEmployDetail.css">
</head>

<body>

    <%- include('header.ejs') %>
    <%- include('sidebar.ejs') %>

    <main class="employee-details-page">

        <!-- Page Heading -->
        <div class="page-heading">
            <div>
                <a href="/" class="back-link">← Back to Employees</a>
                <h1>Employee Profile</h1>
                <p>View and manage employee information.</p>
            </div>

            <div class="top-actions">
                <a
                    class="button button-secondary"
                    href="/editEmploy/<%= employee._id %>"
                >
                    <span>✎</span> Edit Employee
                </a>

                <a
                    class="button button-history"
                    href="/history/<%= employee._id %>"
                >
                    <span>◷</span> History
                </a>
            </div>
        </div>

        <!-- Employee Profile Card -->
        <section class="profile-card">

            <div class="profile-main">

                <div class="profile-avatar">
                    <%= employee.name
                        ? employee.name.trim().split(/\s+/).map(word => word[0]).slice(0, 2).join('').toUpperCase()
                        : 'EM'
                    %>
                </div>

                <div class="profile-identity">
                    <h2><%= employee.name %></h2>

                    <p class="employee-job">
                        <%= employee.jobRole || 'Employee' %>
                    </p>

                    <div class="profile-meta">
                        <span class="employee-id">
                            ID: <%= employee.id %>
                        </span>

                        <span class="status-badge">
                            <span class="status-dot"></span>
                            Employee Record
                        </span>
                    </div>
                </div>

            </div>

            <div class="profile-shift">
                <span class="meta-label">Assigned Shift</span>
                <span class="shift-badge">
                    <%= employee.shiftType || 'Not assigned' %>
                </span>
            </div>

        </section>

        <!-- Statistics Cards -->
        <section class="stats-grid">

            <div class="stat-card">
                <div class="stat-card-top">
                    <span class="stat-label">Hourly Rate</span>
                    <span class="stat-icon purple">₨</span>
                </div>

                <h3>
                    PKR <%= Number(employee.hourleyWage || 0).toLocaleString('en-PK') %>
                </h3>

                <p>Payment per working hour</p>
            </div>

            <div class="stat-card">
                <div class="stat-card-top">
                    <span class="stat-label">Hours This Month</span>
                    <span class="stat-icon blue">◷</span>
                </div>

                <h3>
                    <%= typeof monthlyHours !== 'undefined' ? monthlyHours : 0 %>
                    <small>hrs</small>
                </h3>

                <p>Total recorded working hours</p>
            </div>

            <div class="stat-card">
                <div class="stat-card-top">
                    <span class="stat-label">Estimated Salary</span>
                    <span class="stat-icon green">₨</span>
                </div>

                <h3>
                    PKR <%= Number(
                        typeof monthlySalary !== 'undefined'
                            ? monthlySalary
                            : 0
                    ).toLocaleString('en-PK') %>
                </h3>

                <p>Based on recorded hours</p>
            </div>

        </section>

        <!-- Employee Information -->
        <section class="information-card">

            <div class="section-heading">
                <div>
                    <h2>Personal & Employment Information</h2>
                    <p>Employee details saved in HourFlow.</p>
                </div>

                <a
                    class="button button-secondary"
                    href="/editEmploy/<%= employee._id %>"
                >
                    ✎ Edit Details
                </a>
            </div>

            <div class="information-grid">

                <div class="information-item">
                    <span class="information-label">Full Name</span>
                    <p><%= employee.name || 'Not provided' %></p>
                </div>

                <div class="information-item">
                    <span class="information-label">Employee ID</span>
                    <p><%= employee.id ?? 'Not provided' %></p>
                </div>

                <div class="information-item">
                    <span class="information-label">Job Role</span>
                    <p><%= employee.jobRole || 'Not provided' %></p>
                </div>

                <div class="information-item">
                    <span class="information-label">Email Address</span>
                    <p><%= employee.email || 'Not provided' %></p>
                </div>

                <div class="information-item">
                    <span class="information-label">Phone Number</span>
                    <p><%= employee.PhoneNo || 'Not provided' %></p>
                </div>

                <div class="information-item">
                    <span class="information-label">Joining Date</span>
                    <p>
                        <%= employee.joiningDate
                            ? new Date(employee.joiningDate).toLocaleDateString('en-GB', {
                                day: '2-digit',
                                month: 'short',
                                year: 'numeric'
                            })
                            : 'Not provided'
                        %>
                    </p>
                </div>

                <div class="information-item">
                    <span class="information-label">Shift Type</span>
                    <p><%= employee.shiftType || 'Not assigned' %></p>
                </div>

                <div class="information-item">
                    <span class="information-label">Hourly Wage</span>
                    <p>PKR <%= Number(employee.hourleyWage || 0).toLocaleString('en-PK') %></p>
                </div>

            </div>

        </section>

       

    </main>

</body>
</html>
