<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/addingemploypage.css">
    <title>Document</title>
</head>
<body>
    <div class="adding-employ-div">
        <h1>Edit Employ</h1>

        <form action="/editEmploy/<%=employ._id%>" method="post">
            <div class="input-id-div">
                <h3>Enter Id :</h3>
                <input class="id-input js-id-input" type="number" value="<%=employ.id%>" name='id'>
            </div>
            <div class="input-name-div">
                <h3>Enter Name :</h3>
                <input class="name-input js-name-input" type="text"value="<%=employ.name%>" name="name">
            </div>
            <div class="input-hourleyInput-div">
                <h3>Enter Hourley wage</h3>
                <input class="hourleyInput-input js-hourleyInput-input" type="number" value="<%=employ.hourleyWage%>"
                name="hourleyWage"
                >
            </div>
            <div class="input-shift-div">
                <h3>Select Shift Type :</h3>
                <select class="Select-shift js-Select-shift" name="shiftType">
                    <option <%=employ.shiftType =='Morning' ?'selected' : '' %> >Morning</option>
                    <option  <%=employ.shiftType =='Evening' ?'selected' : '' %>  >Evening</option>
                </select>
            </div>      
            <button class="Save-button js-save-update-button">
            Save
            </button>
        </form>

        <a href="/" class="Cross-sign js-Cross-sign">
        ✖ 
        </a>                  
    </div>
   
    
</body>
</html>